# Copy to .env and fill in. Never commit .env (the repository is public).

# Superuser/owner connection used by scripts (reset, load, pipeline). Database name "retention".
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres
DATABASE_NAME=retention

# Password for the API's least-privileged login role (rs_app_login, member of rs_app).
RS_APP_PASSWORD=CHANGE_ME_TOO

# Tests create and drop their own database named retention_test using the admin connection.

# Optional: simulated clock for the app (the 30 Jun 2026 list is current in July 2026).
# APP_NOW=2026-07-15T10:00:00+00:00
# SECURE_COOKIES=true   # only behind HTTPS
